# ── CELL 14: Inference wrapper — council JSON schema ──────────
STAGE_ORDER = ["germination","seedling","vegetative","flowering","grain_fill","maturity_harvest"]

def predict_growth_stage(img_path):
    from tensorflow.keras.preprocessing import image
    img  = image.load_img(img_path, target_size=(IMG_SIZE, IMG_SIZE))
    x    = image.img_to_array(img) / 255.0
    x    = np.expand_dims(x, axis=0)
    preds      = model.predict(x)[0]
    top_idx    = int(np.argmax(preds))
    stage_name = index_to_class[top_idx]
    confidence = float(preds[top_idx])
    stage_pos  = STAGE_ORDER.index(stage_name) if stage_name in STAGE_ORDER else 0
    return {
        "stage": stage_name,
        "stage_number": stage_pos + 1,
        "confidence": round(confidence, 3),
        "pct_complete": min(95, max(30, int(confidence * 90))),
        "critical_actions": STAGE_ADVICE.get(stage_name, []),
        "next_stage": STAGE_ORDER[stage_pos + 1] if stage_pos < 5 else "post_harvest"
    }

print("\nCouncil output schema:")
print(json.dumps({
    "stage": "flowering", "stage_number": 4,
    "confidence": 0.887, "pct_complete": 65,
    "critical_actions": ["NO pesticide spraying","ensure water availability"],
    "next_stage": "grain_fill"
}, indent=2))


